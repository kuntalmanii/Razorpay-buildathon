{
  "name": "recoveriq-backend",
  "version": "0.1.0",
  "description": "RecoverIQ — AI Revenue Recovery backend: API, Razorpay integration, AI orchestration, policy engine, audit logging",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test TS_NODE_FILES=true TS_NODE_TRANSPILE_ONLY=true node --require ts-node/register --test src/tests/**/*.test.ts",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down 1",
    "migrate:create": "node-pg-migrate create",
    "db:status": "ts-node --transpile-only src/database/migrate.ts",
    "seed:dev": "NODE_ENV=development ts-node --transpile-only src/database/seed.ts"
  },
  "node-pg-migrate": {
    "migrations-dir": "src/database/migrations",
    "typescript": true,
    "tsconfig": "tsconfig.migrations.json",
    "verbose": true
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
