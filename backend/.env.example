# ─── Backend Environment Variables ───────────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# ─────────────────────────────────────────────────────────────────────────────────

# Server
PORT=
NODE_ENV=

# CORS — comma-separated list of allowed origins (e.g. http://localhost:3000)
CORS_ORIGIN=

# Razorpay — obtain from https://dashboard.razorpay.com/app/keys
# KEY_SECRET must NEVER be exposed to the frontend
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Provider (e.g. OpenAI, Gemini — server-side only)
OPENAI_API_KEY=

# Database
DATABASE_URL=

# Auth
JWT_SECRET=
