# ─── Backend Environment Variables ───────────────────────────────────────────────
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# ─────────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=
NODE_ENV=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# e.g. http://localhost:3000
CORS_ORIGIN=

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string
# e.g. postgresql://postgres:password@localhost:5432/recoveriq_dev
DATABASE_URL=
# Connection pool sizing
DB_POOL_MIN=
DB_POOL_MAX=
# Timeouts in milliseconds
DB_CONNECTION_TIMEOUT_MS=
DB_IDLE_TIMEOUT_MS=

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Obtain from https://dashboard.razorpay.com/app/keys
# KEY_SECRET must NEVER be exposed to the frontend
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── AI Provider ───────────────────────────────────────────────────────────────
# Server-side only — never expose to the frontend
OPENAI_API_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error (defaults: debug in dev, info in prod)
LOG_LEVEL=
